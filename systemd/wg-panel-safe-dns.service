[Unit]
Description=Reconcile Safe internet DNS before WireGuard
Before=wg-quick@wg0.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/wg-panel
EnvironmentFile=/etc/wg-panel/wg-panel.env
ExecStart=/opt/wg-panel/venv/bin/python -m wg_panel.dns_bootstrap
RemainAfterExit=yes
UMask=0077
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
